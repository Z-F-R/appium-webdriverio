{
  "name": "appium-webdriverio",
  "version": "1.0.0",
  "description": "Android mobile UI automation using Appium, WebdriverIO and TypeScript",
  "scripts": {
    "test": "rimraf allure-results && wdio run wdio.conf.ts",
    "test:spec": "rimraf allure-results && wdio run wdio.conf.ts --spec ./test/specs/test.e2e.ts",
    "typecheck": "tsc --noEmit",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "mobile-testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "allure-commandline": "^2.46.1",
    "appium-uiautomator2-driver": "^8.7.0",
    "expect-webdriverio": "^8.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
